ANTHROPIC_API_KEY=
# One constant in server/config.py reads this. Change here, not in module code.
ANTHROPIC_MODEL=claude-haiku-5-5

# A random, unguessable topic. Never commit the real value.
NTFY_TOPIC=second-ear-replace-with-random
NTFY_BASE_URL=https://ntfy.sh

# faster-whisper. base.en on the 4060 is the default; drop to cpu/int8 if CUDA breaks.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Where ml/ drops the trained DistilBERT folder.
RISK_MODEL_DIR=models/risk-scorer

# Which model the explainer asks: anthropic (Haiku, the default) or gemini.
EXPLAINER_PROVIDER=anthropic

# Gemini. eval/make_heldout.py uses these to write the held-out test set, and the
# explainer uses them when EXPLAINER_PROVIDER=gemini. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firebase AI Logic. With all three set, the page makes the explainer's model call:
# Gemini Nano on the device when Chrome has it, the cloud model below when it does not.
# They are the web app's config from the Firebase console (Project settings > Your apps).
# Leave them blank and the server's own explainer above answers, as before.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_AI_MODEL=gemini-3.5-flash-lite

# ElevenLabs. Only the demo video's AI voiceover uses this; the app does not.
# Never commit the real key.
ELEVENLABS_API_KEY=

ANTHROPIC_API_KEY=
# One constant in server/config.py reads this. Change here, not in module code.
ANTHROPIC_MODEL=claude-haiku-5-5

# A random, unguessable topic. Never commit the real value.
NTFY_TOPIC=second-ear-replace-with-random
NTFY_BASE_URL=https://ntfy.sh

# faster-whisper. base.en on the 4060 is the default; drop to cpu/int8 if CUDA breaks.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Where ml/ drops the trained DistilBERT folder.
RISK_MODEL_DIR=models/risk-scorer

# Only eval/make_heldout.py uses these, to write the held-out test set.
# The server never calls Gemini. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

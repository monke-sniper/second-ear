{
  "meta": {
    "name": "Second Ear",
    "version": "1.0.0",
    "authored": "2026-11-14",
    "basis": "Phone-first, 360x640, for older adults. Every screen readable at arm's length, one-handed, under stress.",
    "constraints": [
      "Body text never below 18px",
      "Touch targets 48px minimum",
      "Text contrast at least 4.5:1 against its own background",
      "One alert on screen at a time",
      "Colour is never the only signal; every band has a word and a shape"
    ]
  },
  "color": {
    "calm": { "base": "#0F766E", "soft": "#CCFBF1", "ink": "#134E4A", "on": "#FFFFFF" },
    "watch": { "base": "#B45309", "soft": "#FEF3C7", "ink": "#78350F", "on": "#FFFFFF" },
    "scam": { "base": "#B91C1C", "soft": "#FEE2E2", "ink": "#7F1D1D", "on": "#FFFFFF" },
    "neutral": { "base": "#475569", "soft": "#F1F5F9", "ink": "#0F172A", "on": "#FFFFFF" },
    "ink": "#0F172A",
    "muted": "#475569",
    "surface": "#F8FAFC",
    "card": "#FFFFFF",
    "border": "#CBD5E1",
    "focus": "#1D4ED8"
  },
  "type": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif",
    "scale": {
      "display": { "size": 44, "line": 48, "weight": 700, "tracking": -0.5 },
      "title": { "size": 32, "line": 38, "weight": 700 },
      "body": { "size": 20, "line": 28, "weight": 400 },
      "label": { "size": 18, "line": 24, "weight": 600 },
      "caption": { "size": 15, "line": 20, "weight": 400 }
    },
    "numeric": { "variant": "tabular-nums" }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "sm": 8, "md": 16, "lg": 24, "pill": 999 },
  "layout": {
    "phoneWidth": 360,
    "phoneHeight": 640,
    "pageGutter": 16,
    "alertGutter": 24,
    "touchMin": 48
  },
  "motion": {
    "fast": 120,
    "base": 180,
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotion": "respect prefers-reduced-motion: replace motion with an instant state change"
  },
  "elevation": {
    "card": "0 1px 2px rgba(15, 23, 42, 0.08)",
    "sheet": "0 8px 32px rgba(15, 23, 42, 0.24)"
  }
}

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets — never commit
.env

# Model weights and datasets (downloaded, not built)
models/
data/

# Recordings. Audio never goes in the repo; labels do.
eval/calls/*.wav
eval/calls/*.m4a
eval/calls/*.mp3

# Eval results: the JSON and Markdown are committed (they are the evidence);
# plots and anything else are regenerated by eval/run_eval.py
eval/results/*
!eval/results/.gitkeep
!eval/results/*.json
!eval/results/*.md

# The weekend plan is a working document with contact addresses in it; it stays local.
docs/second-ear-plan.md

# Notebook and editor noise
.ipynb_checkpoints/
.DS_Store
*.swp
*.zip

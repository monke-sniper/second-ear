# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets — never commit
.env

# Model weights and datasets (downloaded, not built)
models/
data/

# Recordings. Audio never goes in the repo; labels do.
eval/calls/*.wav
eval/calls/*.m4a
eval/calls/*.mp3

# Eval outputs are regenerated by eval/run_eval.py
eval/results/*
!eval/results/.gitkeep

# Notebook and editor noise
.ipynb_checkpoints/
.DS_Store
*.swp
*.zip
